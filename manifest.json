{
  "manifest_version": 3,
  "name": "Domain Priority",
  "version": "1.2.0",
  "description": "Puts results from domains you choose (such as Wikipedia) first on Google Search™ and hides the sections you don’t want, like ads.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Domain Priority",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*"
      ],
      "css": [
        "early.css"
      ],
      "js": [
        "sections.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}